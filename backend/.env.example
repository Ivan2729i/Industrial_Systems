
# ==========================================
# FIRESIGHT - ENVIRONMENT CONFIGURATION
# ==========================================

# Django
DJANGO_SECRET_KEY=REPLACE_WITH_YOUR_SECRET_KEY
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=firesight_db
POSTGRES_USER=firesight_app
POSTGRES_PASSWORD=REPLACE_WITH_YOUR_DATABASE_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# React / Vite
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# NASA FIRMS: private backend credential
FIRMS_MAP_KEY=
